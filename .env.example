# Copy to .env (gitignored) and fill in. Only the first block is needed to
# run every node; everything below it has a working default.

# Comments go on their own line: python-dotenv reads "KEY=  # note" as the
# value "# note".

# --- Keys -------------------------------------------------------------------
# Tailor (Claude)
ANTHROPIC_API_KEY=
# Sourcer: JSearch on RapidAPI (free tier ~200 requests/month)
RAPIDAPI_KEY=
# Extractor and Ranker stage 2 (Groq free tier)
GROQ_API_KEY=

# --- Tailor -----------------------------------------------------------------
# TAILOR_MODEL=claude-sonnet-5        # claude-opus-5 for a quality comparison
# TAILOR_EFFORT=medium                # adaptive-thinking effort: low | medium | high

# --- Extractor (raw JD -> JobBrief) -----------------------------------------
# Any OpenAI-compatible provider. Defaults: Groq, openai/gpt-oss-120b.
# EXTRACTOR_BASE_URL=https://api.groq.com/openai/v1
# EXTRACTOR_KEY_ENV=GROQ_API_KEY      # the NAME of the variable holding the key
# EXTRACTOR_MODEL=openai/gpt-oss-120b # list what your key can use: python -m src.agents.extractor --list-models

# --- Ranker -----------------------------------------------------------------
# Stage 2 rerank; same defaults as the Extractor.
# RANKER_BASE_URL=https://api.groq.com/openai/v1
# RANKER_KEY_ENV=GROQ_API_KEY
# RANKER_MODEL=openai/gpt-oss-120b
# Profile atom ids stage 1 leaves out, comma-separated. They name entries of
# your private profile.yaml, which is why they live here and not in code.
# A soft-skill atom that matches every posting is the usual candidate.
RANKER_EXCLUDE_ATOMS=
# Only for the qwen3-4b embedder (served by a local Ollama).
# OLLAMA_BASE_URL=http://localhost:11434

# --- Other providers (optional) ---------------------------------------------
# Used when a model is pinned to them in src/config.py (MODEL_SETTINGS) or
# chosen with --provider. Not needed for the defaults above.
# CEREBRAS_API_KEY=                   # free tier serves gpt-oss-120b and qwen-3.8-27b
# OPENROUTER_API_KEY=                 # paid; e.g. Kimi models
# HF_TOKEN=                           # Hugging Face Inference Providers router

# --- Hugging Face Hub (optional) --------------------------------------------
# Skip the Hub's update check when loading a cached embedding model. A model
# not yet in the cache then fails to load until this line is removed.
# HF_HUB_OFFLINE=1
