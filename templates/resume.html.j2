{%- endmacro %}
<!DOCTYPE html>
<html lang="en" style="--scale: {{ scale | default(1) }}">
<head>
<meta charset="utf-8">
<title>{{ contact.name }} — CV</title>
<style>
{% include "print.css" %}
</style>
</head>
<body>

<header class="header">
  <h1 class="name">{{ contact.name }}</h1>
  <div class="contact-line">
    <span class="contact-item">{{ icon("phone") }}{{ contact.phone }}</span>
    <span class="contact-item">{{ icon("envelope") }}<a href="mailto:{{ contact.email }}">{{ contact.email }}</a></span>
  </div>
  <div class="contact-line">
    {% for link in contact.links %}
    <span class="contact-item">{{ icon(link.type) }}<a href="{{ link.url }}">{{ link.label }}</a></span>
    {% endfor %}
  </div>
</header>

<section class="rsection">
  <h2>Professional Summary</h2>
  <div class="rsection-body">
    <p class="flow">{{ summary }}</p>
  </div>
</section>

<section class="rsection">
  <h2>Work Experience</h2>
  <div class="rsection-body">
    {% for job in experience %}
    <div class="entry">
      <div class="entry-head">
        <span class="entry-title">{{ job.company }}</span>
        <span class="entry-dates">{{ job.start }} &ndash; {{ job.end }}</span>
      </div>
      <div class="entry-sub">
        <span>{{ job.title }}</span>
        <span>{{ job.location }}</span>
      </div>
      {% if job.bullets %}
      <ul class="bullets">
        {% for bullet in job.bullets %}
        <li>{{ bullet }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</section>

<section class="rsection">
  <h2>Skills</h2>
  <div class="rsection-body">
    {# NOTE: group["items"], not group.items — dot access on a dict hits
       Python's .items() method instead of the JSON key. #}
    {% for group in skills %}
    <p class="skill-line flow"><strong>{{ group.category }}:</strong> {{ group["items"] | join(", ") }}</p>
    {% endfor %}
  </div>
</section>

<section class="rsection">
  <h2>Education</h2>
  <div class="rsection-body">
    {% for ed in education %}
    <div class="entry">
      <div class="entry-head">
        <span class="entry-title">{{ ed.degree }}</span>
        <span class="entry-dates">{{ ed.start }} &ndash; {{ ed.end }}</span>
      </div>
      <div class="entry-sub">
        <span>{{ ed.institution }}</span>
        <span>{{ ed.location }}</span>
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<section class="rsection">
  <h2>Projects</h2>
  <div class="rsection-body">
    {% for project in projects %}
    <div class="entry">
      <div class="entry-head">
        <span><strong>{{ project.name }}</strong>{% for link in project.links %} &mdash; <a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}</span>
        <span class="entry-dates year">{{ project.year }}</span>
      </div>
      <p class="flow">{{ project.description }}</p>
    </div>
    {% endfor %}
  </div>
</section>

<section class="rsection">
  <h2>Research Publications</h2>
  <div class="rsection-body">
    {% for pub in publications %}
    <p class="pub"><strong>{{ pub.title }}</strong> (<a href="{{ pub.url }}">{{ pub.venue }}</a>, <strong>Citations: {{ pub.citations }}</strong>)</p>
    {% endfor %}
  </div>
</section>

</body>
</html>
